# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional. If set, server-side TTS uses OpenAI's tts-1 (warmer voice).
# If unset, the browser falls back to Web Speech API (works, but more robotic).
OPENAI_API_KEY=

# Optional. OpenAI TTS voice. Defaults to "shimmer" (calm, warm, female).
# Other choices: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=shimmer

# Optional. Port to serve on. Defaults to 3000.
PORT=3000
